# Copy to .env (chmod 600, never commit). run.sh loads it before every run.

# Claude auth: either log in once with `claude` as this user, or set an API key.
# ANTHROPIC_API_KEY=

# Cloudflare Pages deploy. Leave empty to build reports without publishing them.
# Token: My Profile > API Tokens > Custom token with "Account > Cloudflare Pages > Edit".
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Google PageSpeed Insights API key (optional, raises the quota for real-visitor data).
PSI_API_KEY=

# Optional
# CHROME_PATH=/usr/bin/chromium
# RUN_TIMEOUT=4h
# MAX_BUDGET_USD=20
# CLAUDE_MODEL=
# EXTRA_PATH=/home/prospects/.nvm/versions/node/v22.11.0/bin
# GIT_PUSH=1
